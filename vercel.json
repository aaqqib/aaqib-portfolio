{
  "buildCommand": "node generate-blog-index.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/blog-index.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/post.html?slug=:slug"
    }
  ]
}